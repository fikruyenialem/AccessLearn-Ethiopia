# AccessLearn Ethiopia - Environment Configuration

# Application Metadata
PROJECT_NAME="AccessLearn Ethiopia API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security Configuration
# Mandatory secret key for signing JWT tokens (min 32 characters recommended)
# Set a unique, cryptographically strong random string in your local .env file
SECRET_KEY="REPLACE_WITH_SECURE_SECRET_KEY_MIN_32_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# The application connects directly to the specified DATABASE_URL without automatic fallback.
# If unset, config.py defaults to an absolute-path SQLite database file in the project root.
#
# Option A: Local SQLite database file (uncomment to override the default path)
# DATABASE_URL="sqlite:///./accesslearn.db"
#
# Option B: Local PostgreSQL database (when database and user credentials are created)
# DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/accesslearn_db"

# Allowed CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
